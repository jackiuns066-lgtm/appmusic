<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- audio imported by the user (stored inside the app) -->
    <files-path
        name="imported_audio"
        path="imported_audio/" />
    <!-- audio files located on the shared storage (Music / Download folders, ...) -->
    <external-path
        name="external_audio"
        path="." />
    <cache-path
        name="cache"
        path="." />
</paths>
